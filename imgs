// Browser-compatible video codecs
const PLAYABLE_VIDEO_CODECS = ['h264', 'vp8', 'vp9', 'av1', 'theora'];
const PLAYABLE_AUDIO_CODECS = ['aac', 'mp3', 'opus', 'vorbis', 'flac'];

// Cache for video info (codec detection)
const videoInfoCache = {};

function getVideoInfo(filePath) {
    if (videoInfoCache[filePath]) {
        return videoInfoCache[filePath];
    }
    try {
        const result = execSync(
            `ffprobe -v quiet -print_format json -show_streams "${filePath}"`,
            { encoding: 'utf8', timeout: 5000 }
        );
        const info = JSON.parse(result);
        const videoStream = info.streams?.find(s => s.codec_type === 'video');
        const audioStream = info.streams?.find(s => s.codec_type === 'audio');
        const videoInfo = {
            videoCodec: videoStream?.codec_name?.toLowerCase(),
            audioCodec: audioStream?.codec_name?.toLowerCase(),
            playable: videoStream && PLAYABLE_VIDEO_CODECS.includes(videoStream.codec_name?.toLowerCase())
        };
        videoInfoCache[filePath] = videoInfo;
        return videoInfo;
    } catch (err) {
        videoInfoCache[filePath] = { playable: false, error: err.message };
        return videoInfoCache[filePath];
    }
}

function getThumbDir(baseDir) {
    return path.join(baseDir, '.thumbs');
}

function getThumbPath(baseDir, videoFile) {
    const thumbDir = getThumbDir(baseDir);
    const thumbName = path.basename(videoFile) + '.jpg';
    return path.join(thumbDir, thumbName);
}

function ensureThumbDir(baseDir) {
    const thumbDir = getThumbDir(baseDir);
    if (!fs.existsSync(thumbDir)) {
        fs.mkdirSync(thumbDir, { recursive: true });
    }
    return thumbDir;
}

function generateThumbnail(videoPath, thumbPath, callback) {
    const thumbDir = path.dirname(thumbPath);
    ensureThumbDir(thumbDir);

    // Extract frame at 1 second or first frame
    exec(
        `ffmpeg -y -i "${videoPath}" -ss 00:00:01 -vframes 1 -vf "scale=200:-1" "${thumbPath}" 2>/dev/null || ffmpeg -y -i "${videoPath}" -vframes 1 -vf "scale=200:-1" "${thumbPath}" 2>/dev/null`,
        { timeout: 10000 },
        (err) => {
            callback(err, thumbPath);
        }
    );
}

function getThumbnail(baseDir, videoFile, callback) {
    const videoPath = path.join(baseDir, videoFile);
    const thumbPath = getThumbPath(baseDir, videoFile);

    // Check if thumbnail already exists
    if (fs.existsSync(thumbPath)) {
        callback(null, thumbPath);
        return;
    }

    // Generate thumbnail
    ensureThumbDir(baseDir);
    generateThumbnail(videoPath, thumbPath, callback);
}

function getMimeType(filePath) {
    const ext = path.extname(filePath).toLowerCase();
    const mimeTypes = {
        '.jpg': 'image/jpeg',
        '.jpeg': 'image/jpeg',
        '.png': 'image/png',
        '.gif': 'image/gif',
        '.mp4': 'video/mp4',
        '.m4v': 'video/mp4',
        '.webm': 'video/webm',
        '.ogv': 'video/ogg',
        '.mov': 'video/quicktime',
        '.avi': 'video/x-msvideo',
        '.mkv': 'video/x-matroska',
        '.mpg': 'video/mpeg',
        '.mpeg': 'video/mpeg',
        '.wmv': 'video/x-ms-wmv',
        '.flv': 'video/x-flv',
        '.3gp': 'video/3gpp',
        '.rm': 'application/vnd.rn-realmedia',
        '.rmvb': 'application/vnd.rn-realmedia-vbr'
    };
    return mimeTypes[ext] || 'application/octet-stream';
}

function link(str, query)
{
    if (query) {
        if (str.indexOf("?") !== -1) {
            str += "&" + query;
        } else {
            str += "?" + query;
        }
    }
    return str;
}

function orderCookieName(dirRelative)
{
    // Simple hash of directory path to make a short cookie name
    let hash = 0;
    for (let i = 0; i < dirRelative.length; i++) {
        hash = ((hash << 5) - hash + dirRelative.charCodeAt(i)) | 0;
    }
    return 'order_' + Math.abs(hash).toString(36);
}

function getOrderedImages(dir, cookies)
{
    const cookieName = orderCookieName(dir.relative);
    const orderCookie = cookies[cookieName];
    if (orderCookie) {
        try {
            const ordered = JSON.parse(decodeURIComponent(orderCookie));
            if (Array.isArray(ordered)) {
                // Filter to only files that still exist, append any new files
                const existing = new Set(dir.images);
                const result = ordered.filter(f => existing.has(f));
                const inResult = new Set(result);
                dir.images.forEach(f => {
                    if (!inResult.has(f)) {
                        result.push(f);
                    }
                });
                return result;
            }
        } catch (e) {
            // Invalid cookie, ignore
        }
    }
    return dir.images;
}

// Remove image at fromIdx and reinsert at toIdx (post-removal index)
function moveImage(dir, cookies, fromIdx, toIdx)
{
    const images = getOrderedImages(dir, cookies);
    if (fromIdx < 0 || fromIdx >= images.length) {
        return null;
    }
    const result = [...images];
    const [item] = result.splice(fromIdx, 1);
    // Clamp toIdx to valid range after removal
    const insertIdx = Math.max(0, Math.min(toIdx, result.length));
    result.splice(insertIdx, 0, item);
    const cookieName = orderCookieName(dir.relative);
    const cookieValue = encodeURIComponent(JSON.stringify(result));
    return { images: result, setCookie: `${cookieName}=${cookieValue}; Path=/` };
}

// Mulberry32 seeded PRNG — much better distribution than LCG
function seededRandom(seed)
{
    return function() {
        seed |= 0;
        seed = (seed + 0x6D2B79F5) | 0;
        let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
        t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
        return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
    };
}

function shuffleWithSeed(array, seed)
{
    const result = [...array];
    const random = seededRandom(seed);
    for (let i = result.length - 1; i > 0; i--) {
        const j = Math.floor(random() * (i + 1));
        [result[i], result[j]] = [result[j], result[i]];
    }
    return result;
}

function parseCookies(cookieHeader)
{
    const cookies = {};
    if (!cookieHeader) return cookies;
    cookieHeader.split(';').forEach(cookie => {
        const parts = cookie.split('=');
        const name = parts[0].trim();
        const value = parts.slice(1).join('=').trim();
        if (name) cookies[name] = value;
    });
    return cookies;
}

